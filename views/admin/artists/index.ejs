<!DOCTYPE html>
<html>

<head>
    <title>Artists</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #181818;
        }

        .Container {
            display: flex;
        }

        .content {
            flex: 1;
            padding: 40px;
            color: white;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .header h1 {
            font-size: 38px;
            font-weight: bold;
        }

        .search-btn {
            text-decoration: none;
        }

        .search-btn button {
            background: #1DB954;
            color: #111;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            transition: .3s;
        }

        .search-btn button:hover {
            background: #18a34a;
        }

        .artist-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            background: #242424;
            border-radius: 10px;
            overflow: hidden;
        }

        .artist-table th {
            background: #2e2e2e;
            padding: 18px;
            text-align: left;
        }

        .artist-table td {
            padding: 18px;
            border-top: 1px solid #3a3a3a;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #b3b3b3;
        }

        .empty-state h2 {
            margin-bottom: 10px;
        }

        .empty-state p {
            margin-bottom: 20px;
        }

        hr {
            border: none;
            border-top: 1px solid #333;
            margin-bottom: 20px;
        }

        .actions {
            display: flex;
            gap: 10px;
        }

        .action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 70px;
            height: 34px;

            border-radius: 8px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;

            transition: .2s ease;
        }

        .manage-btn {
            background: #323232;
            color: #ffffff;
        }

        .manage-btn:hover {
            background: #444;
        }

        .delete-btn {
            background: #3b1d1d;
            color: #ff6b6b;
        }

        .delete-btn:hover {
            background: #512424;
        }

        .artist-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }
    </style>
</head>

<body>

    <div class="Container">

        <%- include("../partials/sidebar") %>

            <div class="content">

                <div class="header">

                    <h1>Artists</h1>

                    <a href="/admin/artists/search" class="search-btn">
                        <button>+ Search MusicBrainz</button>
                    </a>

                </div>

                <hr>

                <table class="artist-table">

                    <thead>

                        <tr>
                            <th>Name</th>
                            <th>Country</th>
                            <th>Type</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        <% if (artists.length===0) { %>

                            <tr>

                                <td colspan="4">

                                    <div class="empty-state">

                                        <h2>No Artists Yet</h2>

                                        <p>Search and import your first artist.</p>

                                    </div>

                                </td>

                            </tr>

                            <% } else { %>

                                <% artists.forEach(artist=> { %>

                                    <tr> 

                                        <td>
                                            <%= artist.name %>
                                        </td>

                                        <td>
                                            <%= artist.country || "-" %>
                                        </td>

                                        <td>
                                            <%= artist.type %>
                                        </td>



                                        <td>

                                            <!-- <div class="actions">

                                                <a class="action-btn manage-btn"
                                                    href="/admin/artists/<%= artist.id %>/edit">

                                                    Edit

                                                </a>

                                                <form action="/admin/artists/<%= artist.id %>/delete" method="POST"
                                                    style="display:inline;">

                                                    <button type="submit" class="action-btn delete-btn">

                                                        Delete

                                                    </button>

                                                </form>

                                            </div> -->
                                            <a class="action-btn manage-btn"
                                                    href="/admin/artists/<%= artist.id %>/manage">

                                                    Manage

                                                </a>

                                        </td>


                                    </tr>

                                    <% }) %>

                                        <% } %>

                    </tbody>

                </table>

            </div>

    </div>

</body>

</html>