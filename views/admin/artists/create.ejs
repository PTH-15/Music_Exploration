<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial;
        }

        .container {
            display: flex;
        }

        .content {
            flex: 1;
            padding: 40px;
            background: #181818;
            color: white;
            min-height: 100vh;
        }

        form {
            max-width: 900px;
            background: #242424;
            padding: 30px;
            border-radius: 10px;
            margin-top: 30px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            margin-bottom: 20px;
        }

        .row {
            display: flex;
            gap: 20px;
        }

        .row .form-group {
            flex: 1;
        }

        label {
            margin-bottom: 8px;
            font-weight: bold;
        }

        input,
        textarea {

            background: #333;
            color: white;

            border: none;

            border-radius: 8px;

            padding: 12px;

            font-size: 15px;

        }

        textarea {

            resize: vertical;

        }

        button {

            background: #1DB954;

            color: #111;

            border: none;

            padding: 14px 26px;

            border-radius: 8px;

            font-weight: bold;

            cursor: pointer;

        }

        .container {
            display: flex;
            min-height: 100vh;
            background: #181818;
        }

        select {
            width: 100%;
            background: #333;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 12px;
            font-size: 15px;
        }

        .genre-options {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-top: 10px;
        }

        .genre-option {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #333;
            padding: 12px;
            border-radius: 8px;
            cursor: pointer;
        }

        .genre-option:hover {
            background: #404040;
        }

        .genre-option input {
            width: 18px;
            height: 18px;
        }

        .genre-option span {
            color: white;
        }
    </style>
</head>

<body>
    <div class="container">

        <%- include("../partials/sidebar") %>

            <div class="content">

                <h1>Create Artist</h1>

                <form action="/admin/artists" method="POST">
                    <div class="form-group">
                        <label>Artist Name</label>
                        <input type="text" id="name" name="name" value="<%= artist.name %>" required>
                    </div>

                    <div class="form-group">
                        <label>Slug</label>
                        <input type="text" id="slug" name="slug" value="<%= slug %>" readonly>
                    </div>

                    <div class="form-group">
                        <label>Biography</label>
                        <textarea name="biography" rows="6"></textarea>
                    </div>

                    <div class="row">

                        <div class="form-group">
                            <label>Country</label>
                            <input type="text" name="country" value="<%= artist.area ? artist.area.name : '' %>">
                        </div>

                        <div class="form-group">
                            <label>Spotify ID</label>
                            <input name="spotifyId" type="text">
                        </div>

                    </div>

                    <div class="form-group">
                        <label>MusicBrainz ID</label>
                        <input type="text" id="musicBrainzId" name="musicBrainzId" value="<%= artist.id %>" readonly>
                    </div>
                    <div class="form-group">
                        <label>Profile Image URL</label>
                        <input type="text"  name="profileimgurl" placeholder="Paste Profile img URL..">
                    </div>
                    <div class="form-group">
                        <label>Baner Image URL</label>
                        <input type="text" name="bannerimgurl" placeholder="Paste Banner img  URL.." >
                    </div>
                    <div class="form-group">
                        <label>Primary Genre</label>
                        <select name="primaryGenreId" required>
                            <option value="">Select Primary Genre</option>
                            <% genres.forEach(genre => { %>
                                <option
                value="<%= genre.id %>" <%= artist.primaryGenreId === genre.id ? "selected" : "" %>> <%= genre.name %>
            </option><%})%>
                        </select>
                    </div>
                    <div class="form-group">

                        <label>Genres</label>

                        <div class="genre-options">
                            <% genres.forEach(genre=> { %>
                                <label class="genre-option">
                                    <input type="checkbox" name="genreIds" value="<%= genre.id %>">
                                    <span>
                                        <%= genre.name %>
                                    </span>
                                </label>
                                <% }) %>
                        </div>
                    </div>

                   
                    <input type="hidden" name="type" value="<%= artist.type %>">
                    <button>Save Artist</button>

                </form>

            </div>

    </div>
</body>

</html>