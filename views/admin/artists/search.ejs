<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search Artist</title>
    <style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

.container{
    display:flex;
}

.content{
    flex:1;
    min-height:100vh;
    background:#181818;
    color:white;
    padding:40px;
}

h1{
    margin-bottom:30px;
}

.search-form{
    display:flex;
    gap:15px;
    margin-bottom:35px;
}

.search-form input{
    flex:1;
    padding:12px;
    border:none;
    outline:none;
    border-radius:8px;
    background:#2b2b2b;
    color:white;
    font-size:16px;
}

.search-form button{
    padding:12px 22px;
    border:none;
    border-radius:8px;
    background:#1DB954;
    color:#111;
    font-weight:bold;
    cursor:pointer;
}

.search-form button:hover{
    background:#18a34a;
}

.results{
    display:flex;
    flex-direction:column;
    gap:18px;
}

.artist-card{
    background:#242424;
    border-radius:10px;
    padding:20px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.artist-card h2{
    margin-bottom:10px;
}

.artist-card p{
    margin:5px 0;
}

.artist-card button{
    padding:10px 18px;
    border:none;
    border-radius:8px;
    background:#1DB954;
    color:#111;
    font-weight:bold;
    cursor:pointer;
}

.artist-card button:hover{
    background:#18a34a;
}

.empty-state{
    background:#242424;
    padding:20px;
    border-radius:10px;
    text-align:center;
}

</style>
</head>
<body>

<div class="container">

    <%- include("../partials/sidebar") %>

    <div class="content">

        <h1>Search Artist</h1>

        <form action="/admin/artists/search/results" method="GET" class="search-form">

            <input
                type="text"
                name="q"
                placeholder="Search artist..."
                value="<%= query %>"
                required
            >

            <button type="submit">Search</button>

        </form>

        <% if(query && artists.length === 0){ %>

            <div class="empty-state">
                No artists found.
            </div>

        <% } %>

        <div class="results">

            <% artists
                .filter(artist => artist.type === "Group")
                .forEach(artist => { %>

                <div class="artist-card">

                    <div>

                        <h2><%= artist.name %></h2>

                        <p>
                            <strong>Country:</strong>
                            <%= artist.country || "Unknown" %>
                        </p>

                        <p>
                            <strong>Score:</strong>
                            <%= artist.score %>
                        </p>

                    </div>

                    <a href="/admin/artists/new?id=<%= artist.id %>">
                        <button>Select</button>
                    </a>

                </div>

            <% }) %>

        </div>

    </div>

</div>



</body>
</html>