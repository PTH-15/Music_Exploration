<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Search Album</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        .container {
            display: flex;
        }

        .content {
            flex: 1;
            min-height: 100vh;
            background: #181818;
            color: white;
            padding: 40px;
        }

        h1 {
            margin-bottom: 30px;
        }

        .search-form {
            display: flex;
            gap: 15px;
            margin-bottom: 35px;
        }

        .search-form input {
            flex: 1;
            padding: 12px;
            border: none;
            border-radius: 8px;
            background: #2b2b2b;
            color: white;
            font-size: 16px;
        }

        .search-form button,
        .select-btn {
            padding: 12px 22px;
            border: none;
            border-radius: 8px;
            background: #1DB954;
            color: #111;
            font-weight: bold;
            cursor: pointer;
        }

        .results {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .album-card {
            background: #242424;
            border-radius: 10px;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .album-card h2 {
            margin-bottom: 10px;
        }

        .album-card p {
            margin: 5px 0;
        }

        .empty-state {
            background: #242424;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
        }

    </style>
</head>

<body>

    <div class="container">

        <%- include("../partials/sidebar") %>

        <div class="content">

            <h1>Search Album</h1>

            <form
                action="/admin/albums/search/results"
                method="GET"
                class="search-form"
            >

                <input
                    type="hidden"
                    name="artistId"
                    value="<%= artistId %>"
                >

                <input
                    type="text"
                    name="q"
                    placeholder="Search album..."
                    value="<%= query %>"
                    required
                >

                <button type="submit">
                    Search
                </button>

            </form>


            <% if (query && albums.length === 0) { %>

                <div class="empty-state">
                    No albums found.
                </div>

            <% } %>


            <div class="results">

                <% albums.forEach(album => { %>

                    <div class="album-card">

                        <div>

            <h2><%= album.title %></h2>

            <p>
                <strong>Artist:</strong>
                <%= album["artist-credit"]?.[0]?.name || "Unknown" %>
            </p>

            <p>
                <strong>Date:</strong>
                <%= album.date || "Unknown" %>
            </p>

        </div>


                        <a href="/admin/albums/create?id=<%= album.id %>&artistId=<%= artistId %>">

                            <button class="select-btn">
                                Select
                            </button>

                        </a>

                    </div>

                <% }) %>

            </div>

        </div>

    </div>

</body>
</html>