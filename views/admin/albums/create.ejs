<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create Album</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial;
        }

        .container {
            display: flex;
            min-height: 100vh;
            background: #181818;
        }

        .content {
            flex: 1;
            padding: 40px;
            background: #181818;
            color: white;
            min-height: 100vh;
        }

        form {
            max-width: 900px;
            background: #242424;
            padding: 30px;
            border-radius: 10px;
            margin-top: 30px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            margin-bottom: 20px;
        }

        .row {
            display: flex;
            gap: 20px;
        }

        .row .form-group {
            flex: 1;
        }

        label {
            margin-bottom: 8px;
            font-weight: bold;
        }

        input,
        textarea,
        select {
            width: 100%;
            background: #333;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 12px;
            font-size: 15px;
        }

        textarea {
            resize: vertical;
        }

        button {
            background: #1DB954;
            color: #111;
            border: none;
            padding: 14px 26px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
        }

        .genre-options {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-top: 10px;
        }

        .genre-option {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #333;
            padding: 12px;
            border-radius: 8px;
            cursor: pointer;
        }

        .genre-option:hover {
            background: #404040;
        }

        .genre-option input {
            width: 18px;
            height: 18px;
        }

    </style>

</head>

<body>

    <div class="container">

        <%- include("../partials/sidebar") %>

        <div class="content">

            <h1>Create Album</h1>

            <% if (artist) { %>
                <p>Adding album for: <strong><%= artist.name %></strong></p>
            <% } %>

            <form action="/admin/albums" method="POST">

                <input
                    type="hidden"
                    name="artistId"
                    value="<%= artist ? artist.id : '' %>"
                >

                <div class="form-group">

                    <label>Album Title</label>

                    <input
                        type="text"
                        name="title"
                        value="<%= album.title %>"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>Slug</label>

                    <input
                        type="text"
                        name="slug"
                        value="<%= slug %>"
                        readonly
                    >

                </div>


                <div class="form-group">

                    <label>MusicBrainz ID</label>

                    <input
                        type="text"
                        name="musicBrainzId"
                        value="<%= album.id %>"
                        readonly
                    >

                </div>


                <div class="row">

                    <div class="form-group">

                        <label>Album Type</label>

                        <input
                            type="text"
                            name="albumType"
                            value="<%= album['primary-type'] || '' %>"
                            readonly
                        >

                    </div>


                    <div class="form-group">

                        <label>Release Date</label>

                        <input
                            type="date"
                            name="releaseDate"
                            value="<%= album['first-release-date'] || '' %>"
                        >

                    </div>

                </div>


                <div class="form-group">

                    <label>Cover Image URL</label>

                    <input
                        type="text"
                        name="coverImage"
                        placeholder="Paste album cover image URL..."
                    >

                </div>


                <div class="form-group">

                    <label>Genres</label>

                    <div class="genre-options">

                        <% genres.forEach(genre => { %>

                            <label class="genre-option">

                                <input
                                    type="checkbox"
                                    name="genreIds"
                                    value="<%= genre.id %>"
                                >

                                <span><%= genre.name %></span>

                            </label>

                        <% }) %>

                    </div>

                </div>


                <button type="submit">
                    Save Album
                </button>

            </form>

        </div>

    </div>

</body>

</html>