<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create Album</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        .container {
            display: flex;
            min-height: 100vh;
            background: #181818;
        }

        .content {
            flex: 1;
            padding: 40px;
            background: #181818;
            color: white;
            min-height: 100vh;
        }

        h1 {
            margin-bottom: 10px;
        }

        .artist-info {
            color: #aaa;
            margin-bottom: 20px;
        }

        form {
            max-width: 900px;
            background: #242424;
            padding: 30px;
            border-radius: 10px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            margin-bottom: 20px;
        }

        .row {
            display: flex;
            gap: 20px;
        }

        .row .form-group {
            flex: 1;
        }

        label {
            margin-bottom: 8px;
            font-weight: bold;
        }

        input,
        select {
            width: 100%;
            background: #333;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 12px;
            font-size: 15px;
        }

        input[readonly] {
            color: #aaa;
        }

        .genre-options {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-top: 10px;
        }

        .genre-option {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #333;
            padding: 12px;
            border-radius: 8px;
            cursor: pointer;
        }

        .genre-option:hover {
            background: #404040;
        }

        .genre-option input {
            width: 18px;
            height: 18px;
        }

        button {
            background: #1DB954;
            color: #111;
            border: none;
            padding: 14px 26px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            font-size: 15px;
        }

        button:hover {
            background: #18a34a;
        }
    </style>
</head>

<body>

    <div class="container">

        <%- include("../partials/sidebar") %>

        <div class="content">

            <h1>Create Album</h1>

            <p class="artist-info">
                Adding album for: <strong><%= artist.name %></strong>
            </p>

            <form action="/admin/albums" method="POST">

                <!-- Artist ID -->
                <input
                    type="hidden"
                    name="artistId"
                    value="<%= artist.id %>"
                >

                <!-- Album Title -->
                <div class="form-group">
                    <label>Album Title</label>

                    <input
                        type="text"
                        name="title"
                        value="<%= album.title %>"
                        required
                    >
                </div>


                <!-- Slug -->
                <div class="form-group">
                    <label>Slug</label>

                    <input
                        type="text"
                        name="slug"
                        value="<%= slug %>"
                        readonly
                    >
                </div>


                <!-- MusicBrainz ID -->
                <div class="form-group">
                    <label>MusicBrainz ID</label>

                    <input
                        type="text"
                        name="musicBrainzId"
                        value="<%= album.id %>"
                        readonly
                    >
                </div>


                <div class="row">

                    <!-- Release Date -->
                    <div class="form-group">
                        <label>Release Date</label>

                        <input
                            type="text"
                            name="releaseDate"
                            value="<%= album.date || '' %>"
                            placeholder="YYYY-MM-DD"
                        >
                    </div>


                    <!-- Album Type -->
                    <div class="form-group">
                        <label>Album Type</label>

                        <input
                            type="text"
                            name="albumType"
                            value="<%= album['release-group']?.['primary-type'] || '' %>"
                            readonly
                        >
                    </div>

                </div>


                <!-- Cover Image -->
                <div class="form-group">
                    <label>Cover Image URL</label>

                    <input
                        type="text"
                        name="coverImage"
                        placeholder="Paste album cover image URL"
                    >
                </div>


                <!-- Genres -->
                <div class="form-group">

                    <label>Genres</label>

                    <div class="genre-options">

                        <% genres.forEach(genre => { %>

                            <label class="genre-option">

                                <input
                                    type="checkbox"
                                    name="genreIds"
                                    value="<%= genre.id %>"
                                >

                                <span>
                                    <%= genre.name %>
                                </span>

                            </label>

                        <% }) %>

                    </div>

                </div>


                <button type="submit">
                    Save Album
                </button>

            </form>

        </div>

    </div>

</body>

</html>