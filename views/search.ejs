<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= query ? `Search: ${query}` : 'Search' %> · Music Exploration</title>

    <link rel="stylesheet" href="/landing.css">
    <link rel="stylesheet" href="/search.css">
</head>

<body>

<div class="container">

    <!-- ================= NAVBAR ================= -->
    <nav class="navbar">

        <div class="logo">
            Music<span>Exploration</span>
        </div>

        <button class="menu-toggle" id="menuToggle">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <div class="nav-links" id="navLinks">
            <a href="/">Home</a>
            <a href="/explore-artists">Explore</a>
            <a href="/genres">Genres</a>
            <!-- <a href="/artist">Artist</a> -->
            <a href="">About</a>
        </div>

        <!-- NAVBAR SEARCH -->
        <form class="nav-search" action="/search" method="GET">

            <input
                class="input"
                type="search"
                name="q"
                value="<%= query %>"
                placeholder="Search artists, genres, playlists..."
            >

            <button type="submit" class="search-submit" aria-label="Search">
    <svg
        class="search-icon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        width="18"
        height="18">

        <circle
            cx="11"
            cy="11"
            r="7"
            stroke="currentColor"
            stroke-width="2"/>

        <path
            d="M21 21l-4.3-4.3"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"/>

    </svg>
</button>

        </form>

        <div class="nav-auth">
            <a href="/login" class="btn-ghost">Log in</a>
            <a href="" class="btn-solid">Sign up</a>
        </div>

    </nav>



    <!-- ================= SEARCH PAGE ================= -->

    <main class="search-page">

        <% const total = artists.length + albums.length + songs.length + playlists.length; %>

        <section class="section-block search-header-block">

            <div class="section-head">
                <h2>
                    <% if(!query){ %>
                        Search Music Exploration
                    <% } else { %>
                        Results for "<%= query %>"
                    <% } %>
                </h2>
            </div>

            <form class="search-panel" action="/search" method="GET">

                <div class="search-panel-field">

                    <svg
    class="search-panel-icon"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    width="18"
    height="18">

    <circle
        cx="11"
        cy="11"
        r="7"
        stroke="currentColor"
        stroke-width="2"/>

    <path
        d="M21 21l-4.3-4.3"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"/>

</svg>

                    <input
                        class="input"
                        type="search"
                        name="q"
                        value="<%= query %>"
                        placeholder="Search artists, albums, songs or playlists..."
                    >

                </div>

                <div class="search-chips" id="filterChips">

                    <button class="chip is-active" type="button" data-filter="all">
                        All
                        <% if(query){ %>
                            (<%= total %>)
                        <% } %>
                    </button>

                    <button class="chip" type="button" data-filter="artists">
                        Artists (<%= artists.length %>)
                    </button>

                    <button class="chip" type="button" data-filter="albums">
                        Albums (<%= albums.length %>)
                    </button>

                    <button class="chip" type="button" data-filter="songs">
                        Songs (<%= songs.length %>)
                    </button>

                    <button class="chip" type="button" data-filter="playlists">
                        Playlists (<%= playlists.length %>)
                    </button>

                </div>

            </form>

        </section>

        <% if(query && total===0){ %>

            <div class="search-empty">
                <p>No results for "<%= query %>". Try another keyword.</p>
            </div>

        <% } %>

        <% if(!query){ %>

            <div class="search-empty">
                <p>Start typing above to search artists, albums, songs and playlists.</p>
            </div>

        <% } %>

        <!-- keep your artists / albums / songs / playlists sections exactly as they are -->

    </main>



    <footer class="footer">

        <div class="footer-section">
            <h4>Music<span>Exploration</span></h4>
            <p>Your gateway to discover music beyond the algorithm.</p>
        </div>

        <div class="footer-section">
            <h4>Developer</h4>
            <a href="" class="links">Github</a>
            <a href="" class="links">LinkedIn</a>
        </div>

        <div class="footer-section">
            <h4>Resources</h4>
            <a href="" class="links">About</a>
            <a href="" class="links">Contact</a>
            <a href="" class="links">Privacy Policy</a>
        </div>

    </footer>

    <hr>

    <div class="footer-credit">
        © 2026 Music Exploration • Built by Prathmesh (PTH)
    </div>

</div>

<script src="/landing.js"></script>
<script src="/search.js"></script>

</body>
</html>